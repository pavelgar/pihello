# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md,svg,html,css}]
indent_size = 2

[*.toml]
indent_size = 4

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Preset templates and recorded fixtures are content: whitespace is significant
# (alignment, trailing spaces in templates) and fixtures are machine-written.
[src/pihello/presets/*.txt]
trim_trailing_whitespace = false
insert_final_newline = unset

[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_size = unset

[*.{svg,lock}]
insert_final_newline = unset
trim_trailing_whitespace = unset
